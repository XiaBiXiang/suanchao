# Compose public port
APP_PORT=80

# PostgreSQL
POSTGRES_DB=suanchao
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-password

# Backend security
SECRET_KEY=change-this-jwt-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=false

# AI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# SMTP (optional, but required for register/reset/delete verification emails)
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=算潮
SMTP_TIMEOUT_SECONDS=10

# Redis queue timeouts
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5

# Frontend build-time API base URL.
# Keep empty to use same-origin /api through Nginx.
VITE_API_BASE_URL=
